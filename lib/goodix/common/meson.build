# Internal, I/O-free Goodix protocol and image primitives. These sources are
# compiled into libfprint's private driver library and do not form a public ABI.
goodix_common_sources = files(
    'goodix-wire.c',
    'goodix-command.c',
    'goodix-sensor-profile.c',
    'goodix-mcu-config.c',
    'goodix-image.c',
    'goodix-crc.c',
)

goodix_common_inc = include_directories('.')
