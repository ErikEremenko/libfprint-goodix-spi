From: gdix51c0 reverse-engineering project
Subject: [PATCH] device: persist prints changed by successful matching

Some matchers adapt an enrolled template after a successful verification.
Keep a serialized snapshot of each candidate and save the matched print only
when its serialized representation actually changed.  This keeps storage
ownership in fprintd, works for verify and identify, and avoids writes for
ordinary non-adaptive matchers.

Based on fprintd 1.94.5.
---
 src/device.c | 77 +++++++++++++++++++++++++++++++++++++++++++++++++++++
 1 file changed, 77 insertions(+)

diff --git a/src/device.c b/src/device.c
index 4de4a10..62f3273 100644
--- a/src/device.c
+++ b/src/device.c
@@ -113,6 +113,7 @@ typedef struct
   /* Required to restart the operation on a retry failure. */
   FpPrint   *verify_data;
   GPtrArray *identify_data;
+  GHashTable *verify_print_snapshots;
   int        enroll_data;

   /* whether we're running an identify, or a verify */
@@ -248,6 +249,7 @@ fprint_device_finalize (GObject *object)

   g_clear_handle_id (&priv->verify_stop_wait_timeout_id, g_source_remove);
   g_hash_table_destroy (priv->clients);
+  g_hash_table_destroy (priv->verify_print_snapshots);
   session_data_set_new (priv, NULL, NULL);
   g_clear_object (&priv->auth);
   g_clear_object (&priv->dev);
@@ -457,6 +459,10 @@ fprint_device_init (FprintDevice *device)
                                          g_str_equal,
                                          g_free,
                                          _unwatch_name);
+  priv->verify_print_snapshots = g_hash_table_new_full (g_direct_hash,
+                                                        g_direct_equal,
+                                                        g_object_unref,
+                                                        (GDestroyNotify) g_bytes_unref);

   g_signal_connect (device, "g-authorize-method",
                     G_CALLBACK (action_authorization_handler),
@@ -1535,6 +1541,65 @@ stoppable_action_stop (FprintDevice          *rdev,
     stoppable_action_completed (rdev);
 }

+static void
+snapshot_verify_print (FprintDevice *rdev,
+                       FpPrint      *print)
+{
+  FprintDevicePrivate *priv = fprint_device_get_instance_private (rdev);
+  g_autoptr(GError) error = NULL;
+  g_autofree guchar *serialized = NULL;
+  gsize size;
+
+  if (!fp_print_serialize (print, &serialized, &size, &error))
+    {
+      g_warning ("Failed to snapshot print before verification: %s",
+                 error->message);
+      return;
+    }
+
+  g_hash_table_replace (priv->verify_print_snapshots,
+                        g_object_ref (print),
+                        g_bytes_new_take (g_steal_pointer (&serialized), size));
+}
+
+static void
+save_changed_verify_print (FprintDevice *rdev,
+                           FpPrint      *print)
+{
+  FprintDevicePrivate *priv = fprint_device_get_instance_private (rdev);
+  GBytes *before;
+  g_autoptr(GBytes) after = NULL;
+  g_autoptr(GError) error = NULL;
+  g_autofree guchar *serialized = NULL;
+  gsize size;
+  int r;
+
+  before = g_hash_table_lookup (priv->verify_print_snapshots, print);
+  if (!before)
+    return;
+  if (!fp_print_serialize (print, &serialized, &size, &error))
+    {
+      g_warning ("Failed to serialize updated print after verification: %s",
+                 error->message);
+      return;
+    }
+  after = g_bytes_new_take (g_steal_pointer (&serialized), size);
+  if (g_bytes_equal (before, after))
+    return;
+
+  r = store.print_data_save (print);
+  if (r != 0)
+    {
+      g_warning ("Failed to save print updated during verification: %d", r);
+      return;
+    }
+
+  g_debug ("Saved print updated during successful verification");
+  g_hash_table_replace (priv->verify_print_snapshots,
+                        g_object_ref (print),
+                        g_steal_pointer (&after));
+}
+
 static void
 match_cb (FpDevice *device,
           FpPrint  *match,
@@ -1552,6 +1617,9 @@ match_cb (FpDevice *device,
   cancelled = g_cancellable_is_cancelled (priv->current_cancellable);
   matched = match != NULL && cancelled == FALSE;

+  if (matched)
+    save_changed_verify_print (rdev, match);
+
   report_verify_status (rdev, matched, error);
 }

@@ -1584,6 +1652,7 @@ verify_cb (FpDevice *dev, GAsyncResult *res, void *user_data)
   else
     {
       g_clear_object (&priv->verify_data);
+      g_hash_table_remove_all (priv->verify_print_snapshots);

       if (error)
         {
@@ -1629,6 +1698,7 @@ identify_cb (FpDevice *dev, GAsyncResult *res, void *user_data)
   else
     {
       g_clear_pointer (&priv->identify_data, g_ptr_array_unref);
+      g_hash_table_remove_all (priv->verify_print_snapshots);

       if (error)
         {
@@ -1713,6 +1783,9 @@ fprint_device_verify_start (FprintDBusDevice      *dbus_dev,
       g_debug ("start identification device %d", priv->id);
       priv->current_cancellable = g_cancellable_new ();
       priv->identify_data = g_ptr_array_ref (gallery);
+      g_hash_table_remove_all (priv->verify_print_snapshots);
+      for (guint i = 0; i < gallery->len; i++)
+        snapshot_verify_print (rdev, g_ptr_array_index (gallery, i));
       fp_device_identify (priv->dev, gallery, priv->current_cancellable,
                           match_cb, rdev, NULL,
                           (GAsyncReadyCallback) identify_cb, rdev);
@@ -1748,6 +1821,8 @@ fprint_device_verify_start (FprintDBusDevice      *dbus_dev,
       priv->current_action = ACTION_VERIFY;
       priv->current_cancellable = g_cancellable_new ();
       priv->verify_data = g_object_ref (print);
+      g_hash_table_remove_all (priv->verify_print_snapshots);
+      snapshot_verify_print (rdev, print);
       fp_device_verify (priv->dev, print, priv->current_cancellable,
                         match_cb, rdev, NULL,
                         (GAsyncReadyCallback) verify_cb, rdev);
--
2.53.0
